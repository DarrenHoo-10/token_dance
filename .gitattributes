# rustfmt is configured with newline_style = "Unix". Force LF so Windows
# checkouts (core.autocrlf=true) do not convert *.rs to CRLF and fail
# `cargo fmt --check`.
*.rs text eol=lf

# Preserve committed SQL bytes: historical migrations include both LF and CRLF.
# Checkout normalization would change their already-applied SHA-256 checksums.
*.sql -text
