{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "orb-details",
  "description": "Details/peek window IPC for snapshot, preferences, and restricted actions",
  "windows": ["orb-details"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-orb-snapshot",
    "allow-get-orb-details",
    "allow-get-orb-preferences",
    "allow-patch-orb-preferences",
    "allow-orb-action",
    "allow-orb-ready"
  ]
}
