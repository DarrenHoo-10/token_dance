{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for the TokenDance desktop settings shell",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-orb-preferences",
    "allow-patch-orb-preferences",
    "allow-get-orb-details",
    "allow-primary-desktop"
  ]
}
