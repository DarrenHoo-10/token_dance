{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "orb-effects",
  "description": "Effects window may only read the render snapshot and report ready",
  "windows": ["orb-effects"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-orb-render-snapshot",
    "allow-orb-ready"
  ]
}
