{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tokendance-desktop",
  "version": "0.1.7",
  "identifier": "io.tokendance.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TokenDance · 我的用量",
        "label": "main",
        "width": 480,
        "height": 780,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "title": "TokenDance · 采集与设置",
        "label": "settings",
        "url": "index.html?view=settings",
        "width": 680,
        "height": 600,
        "minWidth": 560,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "tooltip": "TokenDance Collector Daemon",
      "iconPath": "icons/32x32.png",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
