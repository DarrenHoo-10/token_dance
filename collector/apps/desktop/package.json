{
  "name": "@tokendance/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:updates": "vitest run scripts/software-update.test.tsx --environment jsdom",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "preview": "vite preview",
    "test": "node scripts/verify-desktop.mjs",
    "test:usage": "node --experimental-strip-types --test scripts/weekly-usage.test.mjs scripts/website.test.mjs scripts/sync-status.test.mjs scripts/usage-analytics.test.mjs scripts/orb-color.test.mjs scripts/orb-format.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
