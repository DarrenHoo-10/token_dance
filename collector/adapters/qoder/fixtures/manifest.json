{
  "$schema": "https://schemas.tokenshow.dev/adapter-manifest/v1.json",
  "manifestVersion": "1.0",
  "id": "dev.tokenshow.adapter.qoder",
  "name": "Qoder",
  "version": "1.0.0",
  "protocolVersion": "1.0",
  "agent": { "id": "qoder", "versionRange": ">=0.1.0 <2.0.0" },
  "platforms": ["windows-x64", "windows-arm64", "macos-x64", "macos-arm64"],
  "sources": ["jsonl_tail"],
  "permissions": {
    "readPaths": [
      { "template": "USER_HOME", "relativeGlob": ".qoder/projects/**", "access": "read" },
      { "template": "USER_HOME", "relativeGlob": ".qoder-cn/projects/**", "access": "read" }
    ],
    "writePaths": [],
    "commands": [],
    "networkDomains": []
  },
  "capabilities": ["tokens", "sessions", "turns", "cost"]
}
