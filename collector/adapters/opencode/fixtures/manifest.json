{
  "$schema": "https://schemas.tokenshow.dev/adapter-manifest/v1.json",
  "manifestVersion": "1.0",
  "id": "dev.tokenshow.adapter.opencode",
  "name": "OpenCode",
  "version": "1.0.0",
  "protocolVersion": "1.0",
  "agent": { "id": "opencode", "versionRange": ">=1.0.0 <3.0.0" },
  "platforms": ["windows-x64", "windows-arm64", "macos-x64", "macos-arm64"],
  "sources": ["sqlite_snapshot"],
  "permissions": {
    "readPaths": [{ "template": "AGENT_CONFIG_HOME", "relativeGlob": "opencode.db", "access": "read" }],
    "writePaths": [],
    "commands": [],
    "networkDomains": []
  },
  "capabilities": ["tokens", "sessions", "turns", "code"]
}
