{
  "$schema": "https://schemas.tokenshow.dev/adapter-manifest/v1.json",
  "manifestVersion": "1.0",
  "id": "dev.tokenshow.adapter.droid",
  "name": "Droid",
  "version": "1.0.0",
  "protocolVersion": "1.0",
  "agent": { "id": "droid", "versionRange": ">=0.1.0 <1.0.0" },
  "platforms": ["windows-x64", "windows-arm64", "macos-x64", "macos-arm64"],
  "sources": ["jsonl_tail"],
  "permissions": {
    "readPaths": [{ "template": "USER_HOME", "relativeGlob": ".factory/logs/**", "access": "read" }],
    "writePaths": [],
    "commands": [],
    "networkDomains": []
  },
  "capabilities": ["tokens", "sessions"]
}
