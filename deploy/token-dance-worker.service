[Unit]
Description=TokenDance background worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=tokendance
Group=tokendance
WorkingDirectory=/opt/token-dance/current
EnvironmentFile=/etc/token-dance/app.env
ExecStart=/opt/token-dance/current/bin/token-dance-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
