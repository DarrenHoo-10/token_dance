[Unit]
Description=TokenDance Test Worker (release branch)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=tokendance-test
Group=tokendance-test
WorkingDirectory=/opt/token-dance-test/current
EnvironmentFile=/etc/token-dance-test/app.env
ExecStart=/opt/token-dance-test/current/bin/token-dance-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
